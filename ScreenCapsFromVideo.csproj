<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ApplicationIcon>app-icon-symbol.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ScreenCapsFromVideo.Tests\**\*.cs" />
    <Page Remove="ScreenCapsFromVideo.Tests\**\*.xaml" />
    <EmbeddedResource Remove="ScreenCapsFromVideo.Tests\**\*" />
    <None Remove="ScreenCapsFromVideo.Tests\**\*" />
    <Content Include="app-icon-symbol.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="app-icon-symbol.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
